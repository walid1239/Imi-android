rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants is list
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    function areFriends(ownerUid, viewerUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(ownerUid)/friends/$(viewerUid))
        && get(/databases/$(database)/documents/users/$(ownerUid)/friends/$(viewerUid)).data.status == 'accepted';
    }

    // Private account data: only the account owner can access it.
    match /users/{uid} {
      allow read, create, update, delete: if isSelf(uid);

      match /friends/{friendUid} {
        allow read: if isSelf(uid);
        // Friend relationships must be created through a trusted server workflow.
        allow write: if false;
      }

      match /statuses/{statusId} {
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['ownerUid', 'text', 'mediaPath', 'createdAt', 'expiresAt'])
          && request.resource.data.ownerUid == uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(28, 'h')
          && (
            (!('text' in request.resource.data)
              || (request.resource.data.text is string
                && request.resource.data.text.size() <= 700))
            && (!('mediaPath' in request.resource.data)
              || (request.resource.data.mediaPath is string
                && request.resource.data.mediaPath.matches('users/' + uid + '/statuses/.*')))
            && (('text' in request.resource.data) || ('mediaPath' in request.resource.data))
          );
        allow read: if resource.data.expiresAt is timestamp
          && resource.data.expiresAt > request.time
          && (isSelf(uid) || areFriends(uid, request.auth.uid));
        allow update: if false;
        allow delete: if isSelf(uid);
      }
    }

    // Authenticated users can see only the minimal public profile projection.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoPath', 'city', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSelf(uid);
    }

    // Published Reels metadata. Videos themselves live in Firebase Storage.
    match /reels/{reelId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'caption', 'videoUrl', 'storagePath', 'contentType', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 300
        && request.resource.data.videoUrl is string
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('reels/' + request.auth.uid + '/.*')
        && request.resource.data.contentType in ['video/mp4', 'video/webm']
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participants', 'createdBy', 'createdAt', 'lastMessage', 'lastMessageAt', 'lastSenderUid'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 50
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.createdAt == request.time;
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderUid'])
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 1000
        && request.resource.data.lastMessageAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'type', 'createdAt', 'mediaPath'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.type in ['text', 'image', 'audio', 'video']
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.type == 'text'
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 10000
              && !('mediaPath' in request.resource.data))
            ||
            (request.resource.data.type in ['image', 'audio', 'video']
              && request.resource.data.mediaPath is string
              && request.resource.data.mediaPath.matches('conversations/' + conversationId + '/.*')
              && (!('text' in request.resource.data)
                || (request.resource.data.text is string && request.resource.data.text.size() <= 1000)))
          );
        allow update, delete: if false;
      }
    }

    // Anything not explicitly modelled above is private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
