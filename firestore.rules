rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants is list
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    function areFriends(ownerUid, viewerUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(ownerUid)/friends/$(viewerUid))
        && exists(/databases/$(database)/documents/users/$(viewerUid)/friends/$(ownerUid))
        && get(/databases/$(database)/documents/users/$(ownerUid)/friends/$(viewerUid)).data.status == 'accepted'
        && get(/databases/$(database)/documents/users/$(viewerUid)/friends/$(ownerUid)).data.status == 'accepted';
    }

    // Private account data: only the account owner can access it.
    match /users/{uid} {
      allow read, create, update, delete: if isSelf(uid);

      match /friends/{friendUid} {
        allow read: if isSelf(uid);
        // Friend relationships must be created through a trusted server workflow.
        allow write: if false;
      }

      match /statuses/{statusId} {
        // Status creation is server-only so expiresAt always uses trusted server time.
        allow create: if false;
        allow read: if resource.data.expiresAt is timestamp
          && resource.data.expiresAt > request.time
          && (isSelf(uid) || areFriends(uid, request.auth.uid));
        allow update: if false;
        allow delete: if isSelf(uid);
      }
    }

    // Friend requests are readable by their two participants only; all writes go through callables.
    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Published Academy content is read-only for clients; publishing is an admin workflow.
    match /courses/{courseId} {
      allow read: if signedIn() && (resource.data.published == true || isAdmin());
      allow create, update, delete: if false;

      match /lessons/{lessonId} {
        allow read: if signedIn() && (
          isAdmin()
          || (get(/databases/$(database)/documents/courses/$(courseId)).data.published == true
            && resource.data.published == true)
        );
        allow create, update, delete: if false;
      }
    }

    // Learners can read only their own enrollment and progress. Cloud Functions own all writes.
    match /users/{uid}/enrollments/{courseId} {
      allow read: if isSelf(uid);
      allow create, update, delete: if false;
    }

    // Authenticated users can see only the minimal public profile projection.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoPath', 'city', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSelf(uid);
    }

    // Published Reels metadata. Videos themselves live in Firebase Storage.
    match /reels/{reelId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'caption', 'videoUrl', 'storagePath', 'contentType', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 300
        && request.resource.data.videoUrl is string
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('reels/' + request.auth.uid + '/.*')
        && request.resource.data.contentType in ['video/mp4', 'video/webm']
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }


    function isCallParticipant(callId) {
      return signedIn()
        && exists(/databases/$(database)/documents/calls/$(callId))
        && (get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid
          || get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid);
    }

    // Call identity and lifecycle are server-owned. Clients exchange SDP and ICE only.
    match /calls/{callId} {
      allow read: if isCallParticipant(callId);
      allow create, delete: if false;
      allow update: if (
        isCallParticipant(callId)
        && resource.data.status == 'ringing'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer'])
        && resource.data.callerUid == request.auth.uid
        && !('offer' in resource.data)
        && request.resource.data.offer is map
        && request.resource.data.offer.keys().hasOnly(['type', 'sdp'])
        && request.resource.data.offer.type == 'offer'
        && request.resource.data.offer.sdp is string
        && request.resource.data.offer.sdp.size() > 0
        && request.resource.data.offer.sdp.size() <= 200000
      ) || (
        isCallParticipant(callId)
        && resource.data.status == 'ringing'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer'])
        && resource.data.calleeUid == request.auth.uid
        && !('answer' in resource.data)
        && request.resource.data.answer is map
        && request.resource.data.answer.keys().hasOnly(['type', 'sdp'])
        && request.resource.data.answer.type == 'answer'
        && request.resource.data.answer.sdp is string
        && request.resource.data.answer.sdp.size() > 0
        && request.resource.data.answer.sdp.size() <= 200000
      );

      match /callerCandidates/{candidateId} {
        allow read: if isCallParticipant(callId);
        allow create: if isCallParticipant(callId)
          && get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex'])
          && request.resource.data.candidate is string
          && request.resource.data.candidate.size() > 0
          && request.resource.data.candidate.size() <= 4096
          && (!('sdpMid' in request.resource.data)
            || (request.resource.data.sdpMid is string && request.resource.data.sdpMid.size() <= 256))
          && (!('sdpMLineIndex' in request.resource.data)
            || (request.resource.data.sdpMLineIndex is int
              && request.resource.data.sdpMLineIndex >= 0
              && request.resource.data.sdpMLineIndex <= 65535));
        allow update, delete: if false;
      }
      match /calleeCandidates/{candidateId} {
        allow read: if isCallParticipant(callId);
        allow create: if isCallParticipant(callId)
          && get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex'])
          && request.resource.data.candidate is string
          && request.resource.data.candidate.size() > 0
          && request.resource.data.candidate.size() <= 4096
          && (!('sdpMid' in request.resource.data)
            || (request.resource.data.sdpMid is string && request.resource.data.sdpMid.size() <= 256))
          && (!('sdpMLineIndex' in request.resource.data)
            || (request.resource.data.sdpMLineIndex is int
              && request.resource.data.sdpMLineIndex >= 0
              && request.resource.data.sdpMLineIndex <= 65535));
        allow update, delete: if false;
      }
    }

    match /conversations/{conversationId} {
      // The current Android and web clients create direct chats only. Keep creation
      // bounded to two distinct, published profiles; group membership needs a
      // separate invitation workflow rather than allowing arbitrary UID injection.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participants', 'createdBy', 'createdAt', 'lastMessage', 'lastMessageAt', 'lastSenderUid'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 1000
        && request.resource.data.lastMessageAt == request.time
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.participants[0]))
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.participants[1]));
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderUid'])
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 1000
        && request.resource.data.lastMessageAt == request.time;
      allow delete: if false;

      // Read receipts are per-member private conversation metadata. Each user
      // may advance only their own read cursor; clients cannot forge another user's receipt.
      match /readReceipts/{uid} {
        allow read: if isConversationMember(conversationId);
        allow create, update: if isConversationMember(conversationId)
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'lastReadAt', 'lastReadMessageId'])
          && request.resource.data.uid == uid
          && request.resource.data.lastReadAt == request.time
          && request.resource.data.lastReadMessageId is string
          && request.resource.data.lastReadMessageId.size() > 0
          && request.resource.data.lastReadMessageId.size() <= 128;
        allow delete: if false;
      }

      // Typing presence is intentionally scoped to one conversation and is short-lived.
      match /typing/{uid} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'isTyping', 'updatedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.isTyping is bool
          && request.resource.data.updatedAt == request.time;
        allow update: if isConversationMember(conversationId)
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'isTyping', 'updatedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.isTyping is bool
          && request.resource.data.updatedAt == request.time
          && request.time > resource.data.updatedAt + duration.value(1, 's');
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'type', 'createdAt', 'mediaPath', 'contentType', 'fileName'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.type in ['text', 'image', 'audio', 'video']
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.type == 'text'
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 10000
              && !('mediaPath' in request.resource.data)
              && !('contentType' in request.resource.data)
              && !('fileName' in request.resource.data))
            ||
            (request.resource.data.type in ['image', 'audio', 'video']
              && request.resource.data.mediaPath is string
              && request.resource.data.mediaPath.matches('conversations/' + conversationId + '/' + request.auth.uid + '/.*')
              && request.resource.data.contentType is string
              && request.resource.data.fileName is string
              && request.resource.data.fileName.size() > 0
              && request.resource.data.fileName.size() <= 120
              && (
                (request.resource.data.type == 'image' && request.resource.data.contentType in ['image/jpeg', 'image/png', 'image/webp'])
                || (request.resource.data.type == 'audio' && request.resource.data.contentType in ['audio/mpeg', 'audio/mp4', 'audio/aac', 'audio/ogg', 'audio/wav', 'audio/webm'])
                || (request.resource.data.type == 'video' && request.resource.data.contentType in ['video/mp4', 'video/webm'])
              )
              && (!('text' in request.resource.data)
                || (request.resource.data.text is string && request.resource.data.text.size() <= 1000)))
          );
        allow update, delete: if false;
      }
    }

    // Anything not explicitly modelled above is private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
