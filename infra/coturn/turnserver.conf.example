# Example only. Do not commit real secrets or private keys.
listening-port=3478
tls-listening-port=5349
fingerprint
lt-cred-mech
use-auth-secret
static-auth-secret=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_FIREBASE_TURN_SHARED_SECRET
realm=turn.example.invalid
server-name=turn.example.invalid

# Restrict relay ports and open the same range in the host firewall.
min-port=49160
max-port=49200

# Bind to all interfaces only when the host firewall is configured correctly.
listening-ip=0.0.0.0

# TLS certificate paths are examples; install valid certificates locally.
cert=/etc/letsencrypt/live/turn.example.invalid/fullchain.pem
pkey=/etc/letsencrypt/live/turn.example.invalid/privkey.pem

no-cli
no-multicast-peers
no-loopback-peers
stale-nonce=600
total-quota=100
user-quota=8
