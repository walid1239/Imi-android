rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants;
    }

    function acceptedFriend(ownerUid) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(ownerUid)/friends/$(request.auth.uid))
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)/friends/$(ownerUid))
        && firestore.get(/databases/(default)/documents/users/$(ownerUid)/friends/$(request.auth.uid)).data.status == 'accepted'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)/friends/$(ownerUid)).data.status == 'accepted';
    }

    match /users/{uid}/avatars/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // The status document ID is part of the object path so expiry can be checked.
    match /users/{uid}/statuses/{statusId}/{fileName} {
      function statusIsActive() {
        return firestore.exists(/databases/(default)/documents/users/$(uid)/statuses/$(statusId))
          && firestore.get(/databases/(default)/documents/users/$(uid)/statuses/$(statusId)).data.expiresAt > request.time;
      }

      allow read: if signedIn()
        && statusIsActive()
        && (request.auth.uid == uid || acceptedFriend(uid));
      // Require an active status document created by the trusted callable before accepting media.
      // The client uploads only after the callable returns the server-created status ID.
      allow create: if signedIn()
        && request.auth.uid == uid
        && statusIsActive()
        && firestore.get(/databases/(default)/documents/users/$(uid)/statuses/$(statusId)).data.ownerUid == uid
        && request.resource != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Public-to-authenticated-user Reels; only the owner can upload/delete.
    match /reels/{uid}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|webm)');
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Conversation media is stored under the sender UID and immutable message ID.
    // Participants can read it; only the sender can create it. Clients cannot overwrite
    // or delete another participant's media through this path.
    match /conversations/{conversationId}/{uid}/{messageId}/{fileName} {
      allow read: if isConversationMember(conversationId);
      allow create: if isConversationMember(conversationId)
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size > 0
        && (
          (request.resource.contentType.matches('image/(jpeg|png|webp)')
            && request.resource.size <= 10 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/(mpeg|mp4|aac|ogg|wav|webm)')
            && request.resource.size <= 20 * 1024 * 1024)
          || (request.resource.contentType.matches('video/(mp4|webm)')
            && request.resource.size <= 50 * 1024 * 1024)
        );
      allow update: if false;
      // Permit cleanup of an orphaned upload only while no message references it.
      allow delete: if isConversationMember(conversationId)
        && request.auth.uid == uid
        && !firestore.exists(/databases/(default)/documents/conversations/$(conversationId)/messages/$(messageId));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
